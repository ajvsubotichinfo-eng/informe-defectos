# ════════════════════════════════════════════════════════
#  CONFIGURACIÓN — copiar a .env y completar
#  En Hostinger se configuran desde el panel de Node.js,
#  no se sube el archivo .env al servidor.
# ════════════════════════════════════════════════════════

# ─── Servidor ──────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Base de datos MySQL (Hostinger) ───────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_informe
DB_PASSWORD=tu_password
DB_NAME=u123456789_informe

# ─── Usuarios y PINs ───────────────────────────────────
# Cada par USER_X_NAME / USER_X_PIN crea un usuario válido.
# Hasta 10 usuarios. Solo el autor puede borrar sus propios daños.
USER_1_NAME=Alejandro
USER_1_PIN=1234

USER_2_NAME=Javier
USER_2_PIN=5678
